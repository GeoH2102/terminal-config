#!/usr/bin/env bash
# Find or build the standard three-pane dev layout in a Rex session, and print
# the session's ID. The `dev` shell function calls this when it runs inside Rex.
#
#   +----------------+-------------+
#   | nvim           | <profile>   |
#   +----------------+-------------+
#   | claude                       |
#   +------------------------------+
#
# Usage:
#   rex-dev-layout SESSION [PROFILE]
#
# tmux-dev-layout owns the profiles and their detection. The profile decides the
# right-hand pane, which differs from the tmux layout:
#
#   python        ipython
#   sql           psql, labelled "sql" so Neovim's <leader>s can send to it
#   node, generic none: Neovim takes the full width above Claude
#   c, rust, go   a shell

set -euo pipefail

session="$1"
profile="${2:-}"
dir="$PWD"

# Running `dev` again returns the existing session instead of building another.
existing="$(rex ls --json | jq -r --arg label "$session" \
  'first(.sessions[]? | select(.label == $label) | .session_id) // empty')"
if [ -n "$existing" ]; then
  printf '%s\n' "$existing"
  exit 0
fi

[ -n "$profile" ] || profile="$(tmux-dev-layout --detect "$dir")"

right_cmd=""
right_label=""
case "$profile" in
  python) right_cmd="$(tmux-dev-layout --python-command "$dir")" ;;
  # dev-sql-url runs in the pane, so the URL never appears in shell history.
  # No pager, or the next <leader>s types into it; wide rows go vertical
  # rather than wrapping in the narrow pane.
  sql) right_cmd='psql -P pager=off -P expanded=auto "$(dev-sql-url)"' right_label=sql ;;
esac

# Type into each pane's shell rather than running the program as the pane's
# command, so quitting the program leaves a prompt, as it does under tmux.
type_command() {
  rex send -s "$sid" -b "$1" "$2"
  rex send-key -s "$sid" -b "$1" enter
}

split() {
  rex split -s "$sid" -b "$editor" --split="$1" --ratio 40 --focus=false -c "$dir" \
    ${2:+--label "$2"} --json | jq -er '.block_ids[0]'
}

created="$(rex new "$session" -c "$dir" --window "$profile" --json)"
sid="$(jq -er '.session_id' <<<"$created")"
editor="$(jq -er '.initial_windows[0].block_ids[0]' <<<"$created")"

# The editor starts first so that Claude finds Neovim's IDE lock file and
# attaches to it without you running /ide by hand.
type_command "$editor" nvim

bottom="$(split below)"
sleep 1 # let Neovim write its IDE lock file first
type_command "$bottom" claude

case "$profile" in
  node | generic) ;;
  *)
    right="$(split right "$right_label")"
    if [ -n "$right_cmd" ]; then
      type_command "$right" "$right_cmd"
    fi
    ;;
esac

printf '%s\n' "$sid"
