#!/usr/bin/env bash
# Build the standard three-pane dev layout in a tmux session.
#
#   +----------------+-------------+
#   | nvim           | <profile>   |
#   +----------------+-------------+
#   | claude                       |
#   +------------------------------+
#
# Usage:
#   tmux-dev-layout [-p PROFILE] [SESSION]
#   tmux-dev-layout --detect [DIR]     print the profile that would be chosen
#   tmux-dev-layout --list-profiles    print valid profile names
#
# The main pane is always Neovim and the bottom pane is always Claude. The
# profile decides only what runs in the right-hand pane.
#
# The `dev` shell function passes the session it has just created. sesh calls
# the script with no argument as a startup_command, in which case it is running
# inside the very pane that Neovim needs to occupy, so it hands the work to the
# tmux server and gets out of the way.

set -euo pipefail

PATH="/opt/homebrew/bin:$PATH"

PROFILES="python c rust go node generic"

self="${BASH_SOURCE[0]}"
case "$self" in
  /*) ;;
  *) self="$PWD/$self" ;;
esac

# --- Profile detection -------------------------------------------------------

# True when the directory holds at least one .c file. Written as a loop rather
# than a glob test so it works on the bash 3.2 that macOS ships.
has_c_sources() {
  local f
  for f in "$1"/*.c; do
    [ -e "$f" ] && return 0
  done
  return 1
}

# Walk up from the given directory looking for the first project marker. Stops
# at the git root, so `dev` works from a subdirectory. Sets PROFILE and
# PROJECT_ROOT.
detect_profile() {
  local dir="$1" m
  PROFILE=generic
  PROJECT_ROOT="$dir"

  while :; do
    PROJECT_ROOT="$dir"

    # Rust and Go first: their markers are unambiguous.
    if [ -f "$dir/Cargo.toml" ]; then PROFILE=rust; return; fi
    if [ -f "$dir/go.mod" ]; then PROFILE=go; return; fi

    for m in pyproject.toml setup.py requirements.txt Pipfile .venv; do
      if [ -e "$dir/$m" ]; then PROFILE=python; return; fi
    done

    # Makefile is deliberately absent here: too many Node and Python projects
    # ship one. A C project without CMake falls through, and you type `dev c`.
    for m in CMakeLists.txt compile_commands.json configure.ac; do
      if [ -f "$dir/$m" ]; then PROFILE=c; return; fi
    done
    if has_c_sources "$dir"; then PROFILE=c; return; fi

    if [ -f "$dir/package.json" ]; then PROFILE=node; return; fi

    # Stop at the git root. Outside a repo, stop at $HOME rather than walking
    # to / and picking up a marker from an unrelated parent directory.
    [ -d "$dir/.git" ] && break
    [ "$dir" = "/" ] && break
    [ "$dir" = "$HOME" ] && break
    dir="$(dirname "$dir")"
  done

  PROFILE=generic
  PROJECT_ROOT="$1"
}

# What runs in the right-hand pane. An empty string leaves a shell prompt.
right_pane_command() {
  case "$1" in
    python)
      if [ -x "$PROJECT_ROOT/.venv/bin/ipython" ]; then
        printf '%s\n' "$PROJECT_ROOT/.venv/bin/ipython"
      else
        printf '%s\n' 'uv run --with ipython ipython'
      fi
      ;;
    c|rust|go) printf '%s\n' 'claude' ;;
    node|generic) printf '%s\n' '' ;;
  esac
}

valid_profile() {
  local p
  for p in $PROFILES; do
    [ "$p" = "$1" ] && return 0
  done
  return 1
}

# --- Arguments ---------------------------------------------------------------

profile=""
session=""

while [ $# -gt 0 ]; do
  case "$1" in
    --list-profiles)
      printf '%s\n' $PROFILES
      exit 0
      ;;
    --detect)
      detect_profile "$(cd "${2:-$PWD}" && pwd)"
      printf '%s\n' "$PROFILE"
      exit 0
      ;;
    -p)
      profile="${2:-}"
      shift 2
      ;;
    -h|--help)
      sed -n '2,20p' "$self" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *)
      session="$1"
      shift
      ;;
  esac
done

if [ -n "$profile" ] && ! valid_profile "$profile"; then
  echo "tmux-dev-layout: unknown profile '$profile' (valid: $PROFILES)" >&2
  exit 1
fi

if [ -z "$session" ]; then
  session="$(tmux display-message -p '#S')"
  # The short sleep lets this pane return to its shell prompt before the
  # background job sends `nvim` to it.
  tmux run-shell -b "sleep 0.5; '$self' ${profile:+-p '$profile'} '$session'"
  exit 0
fi

# --- Layout ------------------------------------------------------------------

dir="$(tmux display-message -p -t "$session" '#{pane_current_path}')"

# Only build the layout in a fresh window, so reconnecting to a session that is
# already laid out does nothing.
if [ "$(tmux list-panes -t "$session" | wc -l | tr -d ' ')" -ne 1 ]; then
  exit 0
fi

detect_profile "$dir"
[ -n "$profile" ] && PROFILE="$profile"
right_cmd="$(right_pane_command "$PROFILE")"

# Pane 1: the editor. It starts first so that Claude finds Neovim's IDE lock
# file and attaches to it without you running /ide by hand.
tmux send-keys -t "$session" 'nvim' C-m

# Claude, full width along the bottom.
tmux split-window -v -t "$session" -c "$dir" -l 40%
sleep 1  # let Neovim write its IDE lock file first
tmux send-keys -t "$session" 'claude' C-m

# Back up to the editor, then split it sideways for the profile pane.
tmux select-pane -t "$session" -U
tmux split-window -h -t "$session" -c "$dir" -l 40%
if [ -n "$right_cmd" ]; then
  tmux send-keys -t "$session" "$right_cmd" C-m
fi

# Name the window after the profile, so the status line tells you which one you
# got when detection guessed.
tmux rename-window -t "$session" "$PROFILE"

# Land the cursor in the editor.
tmux select-pane -t "$session" -L
